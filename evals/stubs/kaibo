#!/usr/bin/env python3
"""A `kaibo` shim that seeds the fake corpus, then hands off to the real kaibo.

It intercepts nothing. The query skill's first command is `kaibo query` or
`kaibo doctrine`, and kaibo checks for ~/.kaibo/knowledge/.git with a plain
filesystem read before it runs any subprocess. Finding no clone, it self-heals
by running `sync`, which stops on "no corpus repo configured" in a sandbox, so
the skill never reaches the qmd stub and every task reads as a broken install.

Everything after seeding is the real kaibo binary, exec'd with the same argv.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _corpus import guard_home, real_binary, seed_clone  # noqa: E402


if __name__ == "__main__":
    guard_home()
    # Seeding runs git, and the git shim must not recurse into seeding.
    os.environ["_CALIPER_SEEDING"] = "1"
    seed_clone()
    del os.environ["_CALIPER_SEEDING"]
    os.execv(real_binary("kaibo"), ["kaibo", *sys.argv[1:]])
