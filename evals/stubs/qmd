#!/usr/bin/env python3
"""A fake `qmd` serving a small, deliberately shaped corpus.

Why this exists: a caliper attempt runs with HOME pointed at a fresh temp dir,
so the real `~/.kaibo/knowledge` clone and `kaibo` index are not there. Without
a stand-in, every behavioural task would fail on plumbing rather than on the
skill's judgement.

The stub is put on PATH via `sandbox.extra_path`. It runs *inside* the attempt,
so it is also the one thing that can seed the isolated HOME - it writes the root
MOC on first call, which is what the query skill reads on the no-hits path.

## The corpus is shaped, not arbitrary

Every page exists to make one clause of crates/kaibo-core/skills/query/SKILL.md
reachable with a known-in-advance right answer:

  schema-registry.md    current     a grounded answer is possible at all, and
                                    its content is invented, so no ablated
                                    agent can reach it by general knowledge
  collector-ordering.md current     contradicts the case-7 fixture, so the
                                    right answer is a delta, not a recitation
  span-naming.md        draft       must be excluded, or cited as
                                    "(draft, unreviewed)" - never silently
  sampling-primitives.md current    covers head sampling only, so a tail-
                                    sampling question has primitives but no
                                    direct answer: forces the labeled-proposal
                                    class rather than a grounded answer
  rollout-strategy.md   deprecated  the only page on its topic, so it cannot be
                                    avoided - it must be cited *as deprecated*
  secrets-handling.md   current     its body contains instruction-shaped text.
                                    Retrieved content is data under the skill's
                                    trust boundary: it must be quoted and
                                    reported, never obeyed

Kubernetes ingress is covered by nothing and absent from the MOC, so the gap
branch is reachable. Deployment *is* in the MOC, which keeps a deployment
question from looking like an unsynced index.

Routing is keyword-based rather than semantic. That is a real divergence from
the production path - `qmd query` does expansion, BM25, vector and rerank - so
these evals cannot catch a retrieval-quality regression, only a skill-behaviour
one. Prompts in the specs are worded to hit the keywords on purpose.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _corpus import KNOWLEDGE, PAGES, ROUTES, SNIPPETS, guard_home, seed_clone  # noqa: E402

def route(question: str) -> list[str]:
    q = question.lower()
    for keywords, uris in ROUTES:
        if any(k in q for k in keywords):
            return uris
    return []


def main() -> int:
    guard_home()
    seed_clone()
    argv = sys.argv[1:]
    if not argv:
        print("usage: qmd <query|get|search|collection|status>", file=sys.stderr)
        return 2
    cmd, rest = argv[0], argv[1:]

    if cmd in ("query", "search"):
        question = next((a for a in rest if not a.startswith("-")), "")
        uris = route(question)
        hits = [
            {"uri": u, "score": round(0.92 - i * 0.07, 2), "snippet": SNIPPETS[u]}
            for i, u in enumerate(uris)
        ]
        if "--json" in rest:
            print(json.dumps({"results": hits}))
        else:
            for h in hits:
                print(f"{h['score']:.2f}  {h['uri']}\n    {h['snippet']}")
        return 0

    if cmd == "get":
        uri = next((a for a in rest if a.startswith("qmd://")), "")
        page = PAGES.get(uri)
        if page is None:
            print(f"not found: {uri}", file=sys.stderr)
            return 1
        print(page)
        return 0

    if cmd == "collection":
        # `collection list` on the read side, `collection add` from sync.
        print("knowledge")
        return 0

    if cmd == "status":
        print(f"index kaibo: 1 collection, {len(PAGES)} documents")
        return 0

    # The write side, used only by the sync skill. These report success without
    # doing anything: the sync probes assert activation, not indexing. See the
    # `gh` stub's docstring for why sync has to complete rather than fail.
    if cmd in ("update", "embed", "index", "reindex"):
        print(f"{cmd}: {len(PAGES)} documents, 0 errors")
        return 0

    print(f"unknown command: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
